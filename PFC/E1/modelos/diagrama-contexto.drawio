        <!-- Clientes -> Sistema -->
        <mxCell id="flow_cli_in" value="Solicitud de pedido personalizado&lt;br&gt;(colores, medidas, diseño) y comprobante de abono" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#111111;strokeColor=#333333;strokeWidth=1.2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actor_clientes" target="sys_central">
          <mxGeometry x="0.02" y="-18" relative="1" as="geometry">
