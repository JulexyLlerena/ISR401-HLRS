        <!-- FLUJOS CON EL SISTEMA (línea continua) -->
        <mxCell id="flow_prop_in" value="Registro y consulta de clientes; registro de&lt;br&gt;productos terminados, ventas, pagos y abonos;&lt;br&gt;registro y seguimiento de pedidos personalizados;&lt;br&gt;registro y coordinación de entregas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#111111;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1667;exitDx=0;exitDy=0;entryX=0.0194;entryY=0.3621;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="actor_propietaria" target="sys_central">
