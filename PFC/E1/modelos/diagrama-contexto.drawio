        <!-- Redes Sociales -> Sistema -->
        <mxCell id="flow_redes_in" value="Consultas iniciales de clientes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#111111;strokeColor=#333333;strokeWidth=1.2;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0.03;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actor_redes" target="sys_central">
          <mxGeometry x="-0.1" y="-75" relative="1" as="geometry">
