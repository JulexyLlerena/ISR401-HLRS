        <mxCell id="flow_banco_sys" value="Validación de transferencias&lt;br&gt;bancarias (abonos)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#111111;strokeColor=#333333;strokeWidth=1.2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0.93;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actor_banco" target="sys_central">
